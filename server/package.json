{
  "name": "edu-server",
  "version": "1.0.0",
  "description": "Бэкенд платформы edu",
  "main": "src/index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.11",
    "fastify": "^5.12.8",
    "postgres": "^4.1.1"
  },
  "private": true,
  "type": "module"
}
