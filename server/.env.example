# Скопируйте этот файл в server/.env и поменяйте значения

# База PostgreSQL
DATABASE_URL=postgres://postgres:пароль@localhost:5432/edu

# Порт и адрес сервера
PORT=3000
HOST=127.0.0.1

# На боевом сервере с HTTPS — true
COOKIE_SECURE=false

# Можно ли регистрироваться без ссылки-приглашения
OPEN_REGISTRATION=true

# Куда сохранять загруженные картинки (относительно папки server)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Администратор, которого создаст `npm run seed` (если его ещё нет)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=придумайте-длинный-пароль
ADMIN_FIRST_NAME=Имя
ADMIN_LAST_NAME=Фамилия
